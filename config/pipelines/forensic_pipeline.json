{
  "metadata": {
    "name": "Forensic Analysis Pipeline",
    "description": "Metadata extraction and code artifact analysis pipeline",
    "version": "1.0",
    "author": "RedOps",
    "tags": ["forensics", "metadata", "analysis"]
  },
  "steps": [
    {
      "name": "Validate Scope",
      "module": "compliance.scope_guard.validate_scope",
      "params": {},
      "enabled": true,
      "continue_on_error": false
    },
    {
      "name": "Audit Pipeline Start",
      "module": "compliance.audit_log.audit_pipeline_start",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Extract EXIF Metadata",
      "module": "metadata.exif.extract_exif",
      "params": {
        "directory": "."
      },
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Extract Document Metadata",
      "module": "metadata.documents.extract_metadata",
      "params": {
        "directory": "."
      },
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Analyze Repository",
      "module": "metadata.code_artifacts.analyze_repository",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Extract Entities",
      "module": "intel.entity_extract.extract_entities",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Cluster Findings",
      "module": "intel.clustering.cluster_findings",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Generate Technical Report",
      "module": "reporting.markdown_report.generate_technical_report",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Export Data",
      "module": "reporting.export.export_all",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    },
    {
      "name": "Audit Pipeline End",
      "module": "compliance.audit_log.audit_pipeline_end",
      "params": {},
      "enabled": true,
      "continue_on_error": true
    }
  ],
  "config": {
    "timeout": 600
  }
}
