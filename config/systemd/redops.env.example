# RedOPS Environment Configuration
# Copy to /etc/redops/env and configure

# Target to scan (required)
REDOPS_TARGET=example.com

# Scan preset (quick, recon, full, ai_enhanced)
REDOPS_PRESET=quick

# AI API Keys (optional - for ai_enhanced preset)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Notification webhooks (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
